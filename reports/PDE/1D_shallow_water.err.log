import numpy as np
from matplotlib import pyplot as plt


x  = np.linspace(0,2*np.pi,1000)
dx = x[1]-x[0]
# define finite difference operator
I  = np.eye(np.size(x))
differential_kernel = np.roll(I, 1,axis=0) -np.roll(I, -1,axis=0)
#print(differential_kernel*dx)




dt     = 0.1
h      = np.exp(-(x-np.pi)**2/0.5**2)
posi   = [randint(0, 100) for p in range(0, 10)]


u      = np.zeros(np.shape(h))

h = np.matrix(h).T
u = np.matrix(u).T



# two equations
# h_t + H (u_x) = 0
# u_t = - g h_x

h_record = np.zeros((1000,200))

plt.figure()
for i in range(0,200):
    if i%20==0:
        plt.plot(x,h)
    h = h-10*differential_kernel.dot(u)*dt
    u = u-10*differential_kernel.dot(h)*dt
    h_record[:,i] = np.squeeze(h)
