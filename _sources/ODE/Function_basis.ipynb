   "source": [
    "x = np.linspace(0,2*np.pi,100)\n",
    "a = np.linspace(-1,1,100)\n",
    "b = (1-a**2)**0.5\n",
    "plt.scatter(a,b)\n",
    "plt.figure()\n",
    "for i in range(0,100,5):\n",
    "    function = a[i]*np.cos(x)+b[i]*np.sin(x)\n",
    "    plt.plot(function)\n",
    "    "
